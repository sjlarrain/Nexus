{
  "name": "warm-intro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "emul": "firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "seed:reset": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts --reset",
    "check:firebase": "tsx --conditions=react-server --env-file=.env.local scripts/check-firebase.ts",
    "deploy:rules": "tsx --env-file=.env.local scripts/deploy-rules.ts",
    "demo:deck": "tsx --conditions=react-server --env-file=.env.local scripts/demo-deck.ts",
    "verify:swipe": "tsx --conditions=react-server --env-file=.env.local scripts/verify-swipe.ts"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "firebase-tools": "^15.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "re2@1.26.1": true
  }
}
